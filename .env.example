# Copy to .env and edit if the backend IP changes (it changes when the Mac switches Wi-Fi).

# Used by the dev server proxy (npm run dev):
BACKEND_URL=http://192.168.0.189:8080

# Optional: make the browser call the backend directly (needs CORS enabled on the backend).
# Needed for `npm run build` deployments if the backend is not at the default address.
# VITE_API_URL=http://192.168.0.189:8080
